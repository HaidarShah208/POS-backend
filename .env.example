# Server
NODE_ENV=development
PORT=3000

# Supabase PostgreSQL (use connection string from Supabase Dashboard > Settings > Database)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS (comma-separated; allow frontend origins)
# CORS_ORIGIN=http://localhost:3001,https://your-frontend.vercel.app

# Supabase Storage (Dashboard > Project Settings > API)

SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=uploads
